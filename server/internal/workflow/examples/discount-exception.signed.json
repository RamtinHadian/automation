      "type": "number"
    },
    {
      "key": "reason",
      "label": "دلیل (مثلاً رقیب، خرید حجمی)",
      "required": true,
      "type": "textarea"
    }
  ],
  "format": "hoormand-workflow/1",
  "id": "discount-exception",
