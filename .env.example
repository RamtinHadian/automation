APP_ENV=development
PORT=8090
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=enterprise_automation_db
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=30
# Must be overridden with a unique, random value in any non-development environment.
JWT_SECRET=super-secret-enterprise-jwt-key-32bytes!
JWT_EXPIRY_HOURS=12
# Comma-separated list of browser origins allowed to call this API with credentials.
# Leave empty to disable cross-origin browser access entirely.
CORS_ALLOWED_ORIGINS=
UPLOAD_DIR=./uploads

# Only used if you start the optional pgAdmin service (docker compose --profile tools up -d).
PGADMIN_EMAIL=admin@enterprise.local
PGADMIN_PASSWORD=change-me
