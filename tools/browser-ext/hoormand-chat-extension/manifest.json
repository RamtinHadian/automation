{
  "manifest_version": 3,
  "name": "هورمند: ارسال پیام در پیام‌رسان‌ها",
  "version": "1.4.7",
  "description": "وقتی از هورمند روی مشتری در روبیکا، بله یا ایتا کلیک می‌کنید، مشتری را پیدا می‌کند، گفتگو را باز می‌کند و پیام آماده را می‌نویسد.",
  "content_scripts": [
    {
      "matches": [
        "https://web.rubika.ir/*",
        "https://web.bale.ai/*",
        "https://web.eitaa.com/*",
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "هورمند: ارسال پیام در پیام‌رسان‌ها"
  }
}